# Copy this file to .env and fill in your values. Never commit .env.

# brapi.dev token (free account). Without it, only a few tickers work
# (PETR4, VALE3, MGLU3, ITUB4).
BRAPI_TOKEN=

# How long a quote is reused before asking brapi again.
PRICE_CACHE_MINUTES=15

# Database (default: a local SQLite file). PostgreSQL works too, e.g. the
# connection string Neon gives you (postgres://... or postgresql://...).
# DATABASE_URL=sqlite:///investtrack.db

# Password reset emails. Without RESEND_API_KEY the email is only written
# to the server log (fine in development, never in production: the log
# would hold working reset links). MAIL_FROM must be on a domain verified
# at resend.com.
# RESEND_API_KEY=
# MAIL_FROM=InvestTrack <nao-responda@investtrack.online>

# Where the site lives, for links in emails (never taken from the request).
# PUBLIC_URL=http://localhost:5173
