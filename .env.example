# Copy this file to .env and fill in your values. Never commit .env.

# brapi.dev token (free account). Without it, only a few tickers work
# (PETR4, VALE3, MGLU3, ITUB4).
BRAPI_TOKEN=

# How long a quote is reused before asking brapi again.
PRICE_CACHE_MINUTES=15

# Database (default: a local SQLite file).
# DATABASE_URL=sqlite:///investtrack.db
